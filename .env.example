# Root .env is read by docker-compose only. For running services locally, use each service's own .env
# (server/.env.example, nlp-service/.env.example, client/.env.example).

# REQUIRED: long random string used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string
# optional: shared secret between server and nlp-service (leave empty to disable)
NLP_INTERNAL_KEY=

# LLMs (Gemini primary, Groq fallback). At least one is needed for answers, key points, quizzes...
GEMINI_API_KEY=
# Gemini: gemini-3.5-flash-lite (default, cheap/high free quota) or gemini-3.8-flash (stronger). Check ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
# Groq retired its Llama 3.x chat models on 2026-08-16; openai/gpt-oss-120b (or qwen/qwen3.6-27b) is the recommended replacement. See console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b

# Research chain: Tavily -> Wikipedia (no key) -> SerpAPI. Study resources: YouTube Data API v3.
TAVILY_API_KEY=
SERPAPI_API_KEY=
YOUTUBE_API_KEY=
