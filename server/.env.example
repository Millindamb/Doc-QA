PORT=5000
MONGODB_URI=mongodb://localhost:27017/docqa
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
NLP_SERVICE_URL=http://localhost:8000
NLP_INTERNAL_KEY=
MAX_UPLOAD_MB=20
CLIENT_ORIGIN=http://localhost:5173

# ---- Part 2: LLM wrapper (Gemini primary, Groq fallback) ----
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini: gemini-3.5-flash-lite (default, cheap/high free quota) or gemini-3.8-flash (stronger). Check ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=
# Groq retired its Llama 3.x chat models on 2026-08-16; openai/gpt-oss-120b (or qwen/qwen3.6-27b) is the recommended replacement. See console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# ---- Part 2: analysis defaults ----
ANALYZE_SUMMARY_TOP_N=5
ANALYZE_KEYWORDS_TOP_N=15

# ---- Part 3: chat ----
NLP_TIMEOUT_MS=30000
CHAT_HISTORY_MESSAGES=6
CHAT_HISTORY_MAX_CHARS=1500
CHAT_MESSAGE_MAX_CHARS=4000
CHAT_SOURCE_SNIPPET_CHARS=240

# ---- Part 4: quiz / research / resources ----
QUIZ_MAX_COUNT=20
# research chain: Tavily -> Wikipedia (no key needed) -> SerpAPI. Leave keys empty to skip a provider.
TAVILY_API_KEY=
SERPAPI_API_KEY=
YOUTUBE_API_KEY=
SEARCH_TIMEOUT_MS=10000
RESEARCH_MAX_SOURCES=6
# YouTube ranking weights (relative) and duration filter in minutes
YT_WEIGHT_TITLE=0.4
YT_WEIGHT_VIEWS=0.25
YT_WEIGHT_RECENCY=0.2
YT_WEIGHT_DURATION=0.15
YT_MIN_MINUTES=5
YT_MAX_MINUTES=40
YT_MAX_RESULTS=6
