# ---- chunking ----
CHUNK_TARGET_TOKENS=300
CHUNK_OVERLAP_TOKENS=50

# ---- limits ----
MAX_UPLOAD_MB=20
# a PDF page with fewer extracted characters than this is treated as scanned -> OCR
MIN_PAGE_CHARS=25
# if the whole document yields fewer characters than this after OCR -> needs_llm_ocr=true
MIN_TOTAL_CHARS=20

# ---- OCR ----
OCR_ENGINES=easyocr,tesseract
OCR_LANGS=en
TESSERACT_LANG=eng
OCR_GPU=false
OCR_DPI=200
# more scanned pages than this -> skip local OCR and set needs_llm_ocr=true
MAX_OCR_PAGES=40
# below this mean confidence (0..1) the result is flagged needs_llm_ocr=true
OCR_MIN_CONFIDENCE=0.5
# at/above this confidence the first OCR result is accepted without trying other variants/engines
OCR_GOOD_CONFIDENCE=0.75

# ---- security (optional): if set, callers must send header X-Internal-Key ----
NLP_INTERNAL_KEY=

# ---- Part 2: analysis ----
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SUMMARY_TOP_N=5
KEYWORDS_TOP_N=15
KMEANS_K_MIN=2
KMEANS_K_MAX=8
TOPIC_TOP_TERMS=6

# keyword source merge weights (should sum to ~1.0)
KEYWORD_WEIGHT_TFIDF=0.4
KEYWORD_WEIGHT_RAKE=0.3
KEYWORD_WEIGHT_YAKE=0.3

# exam-mode importance feature weights (should sum to ~1.0)
IMPORTANCE_WEIGHT_TFIDF=0.25
IMPORTANCE_WEIGHT_HEADING=0.15
IMPORTANCE_WEIGHT_DEFINITION=0.2
IMPORTANCE_WEIGHT_NUMERIC=0.1
IMPORTANCE_WEIGHT_POSITION=0.1
IMPORTANCE_WEIGHT_TEXTRANK=0.2

# ---- Part 3: retrieval ----
# hybrid relevance = alpha * normalized_BM25 + (1 - alpha) * cosine
RETRIEVAL_ALPHA=0.4
RETRIEVAL_TOP_K_KNOWLEDGE=8
RETRIEVAL_TOP_K_EXAM=5
# exam mode: final = relevance * W_REL + normalized_importance * W_IMP
EXAM_RERANK_WEIGHT_RELEVANCE=0.6
EXAM_RERANK_WEIGHT_IMPORTANCE=0.4
# exam mode shortlists top_k * this by relevance before re-ranking by importance
EXAM_CANDIDATE_MULTIPLIER=3
# "context sufficient?" heuristics: best cosine >= MIN_COSINE_SUFFICIENT (real embeddings only)
# OR share of query terms found in a retrieved chunk >= MIN_TERM_COVERAGE
MIN_COSINE_SUFFICIENT=0.25
MIN_TERM_COVERAGE=0.5
BM25_CACHE_SIZE=32

# ---- Part 3: intent router ----
# ROUTER_DATA_PATH=data/intents.csv
# ROUTER_MODEL_PATH=artifacts/router.joblib
ROUTER_RULES_CONFIDENCE=0.95
ROUTER_MIN_CONFIDENCE=0.45
# drop candidates scoring below this fraction of the best chunk's relevance (both modes)
RETRIEVAL_MIN_RELEVANCE_RATIO=0.10
